using Gtk 4.0;
using Adw 1;

template $McpgReplicationPage: Gtk.Box {
  orientation: vertical;

  Adw.Banner error_banner {
    revealed: false;
  }

  Adw.Banner privilege_note {
    revealed: false;
    title: _("Standby details are hidden without pg_monitor. Blank columns do not mean the standby is idle.");
  }

  Gtk.ScrolledWindow {
    vexpand: true;

    child: Gtk.Box {
      orientation: vertical;
      spacing: 18;
      margin-start: 12;
      margin-end: 12;
      margin-top: 12;
      margin-bottom: 12;

      Gtk.Box standbys_group {
        orientation: vertical;
        spacing: 6;

        Gtk.Label {
          xalign: 0;
          label: _("Connected standbys");

          styles ["heading"]
        }

        Gtk.Label standbys_empty {
          xalign: 0;
          label: _("No standby is connected to this server.");

          styles ["dim-label"]
        }

        Gtk.ColumnView standbys_view {
          show-column-separators: true;
          reorderable: false;
        }
      }

      Gtk.Box receiver_group {
        orientation: vertical;
        spacing: 6;
        visible: false;

        Gtk.Label {
          xalign: 0;
          label: _("Upstream");

          styles ["heading"]
        }

        Gtk.Label receiver_detail {
          xalign: 0;
          wrap: true;
        }
      }

      Gtk.Box slots_group {
        orientation: vertical;
        spacing: 6;

        Gtk.Label {
          xalign: 0;
          label: _("Replication slots");

          styles ["heading"]
        }

        Gtk.Label slots_empty {
          xalign: 0;
          label: _("This server has no replication slots.");

          styles ["dim-label"]
        }

        Gtk.Label slots_note {
          xalign: 0;
          visible: false;
          wrap: true;

          styles ["dim-label", "caption"]
        }

        Gtk.ColumnView slots_view {
          show-column-separators: true;
          reorderable: false;
        }
      }

      Gtk.Box logical_group {
        orientation: vertical;
        spacing: 6;
        visible: false;

        Gtk.Label {
          xalign: 0;
          label: _("Logical replication");

          styles ["heading"]
        }

        Gtk.ColumnView subscriptions_view {
          show-column-separators: true;
          reorderable: false;
        }

        Gtk.Label publications_note {
          xalign: 0;
          wrap: true;

          styles ["dim-label", "caption"]
        }
      }
    };
  }
}
